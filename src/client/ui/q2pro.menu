/*
This is example menu definition file for Q2PRO.

File format is line based, whitespace is ignored.  C and C++ style comments are
supported.  Long lines can be broken into multiple ones by escaping linefeed
characters with backslashes.

Lines are macro expanded at script load time just as usual console commands.
Any cvars and macros can be referenced.

Maximum line length after expansion is limited to 1024 chars (this is Q2
command line parser limitation). Menu items of spin control type (‘values’ and
‘strings’) support special hack that avoids 1024 chars limit by performing
expansion after command line is parsed: prefix cvar name to be expanded with
"$$" instead of "$".

Duplicate menu entries override previous ones.  Built-in menus (‘demos’,
‘servers’ and ‘players’) can not be overridden.  When user presses ESC while
disconnected, ‘main’ menu is pushed.  When user presses ESC while spawned in
game, ‘game’ menu is pushed if it is found, otherwise ‘main’ menu is pushed.

Supported keywords and their syntax:

include <filename>

background <color|image>
font <image>
cursor <image>
weapon <model>

color <state> <color>

begin <menuname>
   title <menutitle>
   banner <image>
   background <color|image>
   plaque <plaque> [logo]
   style [--compact|--no-compact] [--left|--center|--right] [--transparent|--no-transparent] [--live|--no-live]

   range [--show-value] [--status <text>] <name> <cvar> <min> <max> [step]

   pairs [--show-value] [--status <text>] <name> <cvar> <string1> <value1> [...]
   values [--show-value] [--status <text>] <name> <cvar> <string1> [...]
   strings [--show-value] [--status <text>] <name> <cvar> <value1> [...]
   toggle [--show-value] [--status <text>] <name> <cvar> [~][bit]

   bind <name> <command>
   action <name> <command>
   bitmap <image> <command>
   savegame <slot>
   loadgame <slot>
   blank

   field [--center] [--color|--picker] [--integer|--numeric] [--status <text>] [--width <chars>] <name> <cvar>
end
*/

background #3f6da080
font prochars
cursor ch1
weapon w_railgun.md2

color normal    #c8d0daff
color selectable #c8d0daff
color alternate #ffffffff
color title     #ffffffff
color active    #aa4651ff
color selection #26384d66
color disabled  #5f646cff


begin video
    title "Video Setup"
    background #3f6da080
    style --compact --center --transparent --live
    values --status "Switch between fullscreen and windowed modes." "video mode" vid_fullscreen windowed $$vid_modelist
    toggle --status "Keep fullscreen visible and release the mouse while console is open on multi-monitor setups." "multi-monitor" vid_fullscreen_multimonitor --show-if vid_fullscreen !windowed
    values --status "Adjust how Field of View is calculated for wide screens." "fov scaling" cl_adjustfov vert- hor+
    toggle --status "Synchronize frame rate with monitor refresh to prevent tearing." "vertical sync" gl_swapinterval
    pairs --status "Smooth jagged edges of geometry (requires video restart)." "anti-aliasing" gl_multisamples no 0 "2x MSAA" 2 "4x MSAA" 4 "8x MSAA" 8
    range --show-value --status "Adjust the brightness balance of game textures." "texture gamma" vid_gamma 1.3 0.3
    toggle --status "Toggle use of monitor hardware for gamma correction." "hardware gamma" vid_hwgamma
    range --show-value --status "Lower values increase texture detail (requires video restart)." "texture quality" gl_picmip 3 0 -1
    pairs --status "Choose between classic pixelated or modern smooth textures." "texture filter" gl_texturemode \
        nearest GL_NEAREST \
        linear GL_LINEAR \
        bilinear GL_LINEAR_MIPMAP_NEAREST \
        trilinear GL_LINEAR_MIPMAP_LINEAR
    pairs --status "Improve texture clarity on surfaces viewed at an angle." "anisotropic filter" gl_anisotropy no 1 2x 2 4x 4 8x 8 16x 16
    range --show-value --status "Adjust the color intensity of game world textures." "texture saturation" gl_saturation 0 1
    pairs --status "Boost the overall brightness of textures." "texture intensity" intensity 1x 1 2x 2 3x 3
    range --show-value --status "Adjust the color intensity of static lightmaps." "lightmap saturation" gl_coloredlightmaps 0 1
    range --show-value --status "Fine-tune the brightness of static lighting." "lightmap brightness" gl_brightness 0 0.3
    values --status "Legacy GL1.x vs Modern GL3.x shaders (requires video restart)." "rendering backend" gl_shaders legacy shaders
end

begin options
    title "Options"
    background #3f6da080
    style --compact --center --transparent
    toggle "Advanced UI" ui_advanced
    action "Advanced option" "echo test" --show-if ui_advanced 1
    action --status "Customize your player name and appearance." "player setup" pushmenu players
    action --status "Configure jump-specific HUD and assist tools." "jump setup" pushmenu jump
    action --status "Adjust mouse sensitivity and input settings." "input setup" pushmenu input
    action --status "Bind movement and game actions to keys." "key bindings" pushmenu keys
    action --status "Specific weapon selection bindings." "weapon bindings" pushmenu weapons
    action --status "Graphics, resolution, and quality settings." "video setup" pushmenu video
    action --status "Audio levels and engine settings." "sound setup" pushmenu sound
    action --status "Explosions, shadows, and rail trails." "effects setup" pushmenu effects
    action --status "HUD size, opacity, and scaling." "screen setup" pushmenu screen
    action --status "Asset downloading preferences." "download options" pushmenu downloads
    action --status "Quick-connect address book." "address book" pushmenu addressbook
end

begin sound
    title "Sound Setup"
    background #3f6da080
    style --compact --center --transparent
    values --status "Select the audio output engine (OpenAL recommended)." "sound engine" s_enable "no sound" "software" "OpenAL"
    range --show-value --status "Lower values reduce delay but may cause stuttering." "sound latency" s_mixahead 0.05 0.2 --show-if s_enable !0
    range --show-value --status "Overall volume of sound effects and voices." "effects volume" s_volume 0 1 --show-if s_enable !0
    range --show-value --status "Volume level for background OGG music." "music volume" ogg_volume 0 1 --show-if ogg_enable !0
    toggle --status "Enable or disable background music playback." "enable music" ogg_enable --show-if s_enable !0
    toggle --status "Play music tracks in random order." "shuffle tracks" ogg_shuffle --show-if ogg_enable !0
    toggle --status "Apply a muffled audio filter when submerged." "underwater effect" s_underwater --show-if s_enable !0
    values --status "Ambient map sounds like wind or humming machinery." "ambient sounds" s_ambient "no" "yes" "only player's own" --show-if s_enable !0
    values --status "Sound notification when receiving a chat message." "chat beep" cl_chat_sound "disabled" "default" "alternative" --show-if s_enable !0
end

begin railtrail
    title "Railgun Trail Setup"
    background #3f6da080
    style --compact --center --transparent
    values --status "Visual style of the railgun beam." "rail trail type" cl_railtrail_type \
        "default" "core only" "core and spiral"
    range --show-value --status "How long the trail remains visible in seconds." "rail trail duration" cl_railtrail_time 0.1 3.0 0.1
    range --show-value --status "Thickness of the inner beam." "core width" cl_railcore_width 1 6 1
    range --show-value --status "Radius of the outer spiral effect." "spiral radius" cl_railspiral_radius 1 6 1
    strings --status "Color of the inner beam." "core color" cl_railcore_color \
        black red green yellow blue cyan magenta white
    strings --status "Color of the outer spiral." "spiral color" cl_railspiral_color \
        black red green yellow blue cyan magenta white
end

begin effects
    title "Effects Setup"
    background #3f6da080
    style --compact --center --transparent
    values --status "World lighting from projectiles and explosions." "dynamic lighting" gl_dynamic "no" "yes" "only switchable"
    values --status "Cartoon-style thick outlines on players and items." "entity cel-shading" gl_celshading no 1x 2x 3x
    toggle --status "Enable glowing shell around certain entities." "entity glowing" cl_noglow ~
    values --status "Drop-shadows under players and objects." "ground shadows" gl_shadows no yes fade
    toggle --status "Screen tinting from items and environment (lava/water)." "screen blending" gl_polyblend
    toggle --status "Visual distortion effect when underwater." "screen warping" gl_waterwarp
    toggle --status "Show or hide grenade explosion effects." "grenade explosions" cl_disable_explosions ~0
    toggle --status "Show or hide rocket explosion effects." "rocket explosions" cl_disable_explosions ~1
    blank
    action --status "Customize railgun beam colors and style." --align "railgun trail setup..." pushmenu railtrail
end

begin crosshair
    title "Crosshair Setup"
    background #3f6da080
    style --compact --center --transparent
    values --status "Style of the center-screen aiming cursor." "crosshair type" crosshair none cross dot angle
    pairs --status "Change the physical size of the crosshair." "crosshair scale" ch_scale 0.5x 0.5 1x 1 2x 2 --show-if crosshair !0
    toggle --status "Change crosshair color based on player health." "color by health" ch_health --show-if crosshair !0
    range --show-value --status "Red intensity of the crosshair color." "red channel" ch_red 0 1 --show-if crosshair !0
    range --show-value --status "Green intensity of the crosshair color." "green channel" ch_green 0 1 --show-if crosshair !0
    range --show-value --status "Blue intensity of the crosshair color." "blue channel" ch_blue 0 1 --show-if crosshair !0
    range --show-value --status "Opacity level of the crosshair." "alpha channel" ch_alpha 0 1 --show-if crosshair !0
end

begin screen
    title "Screen Setup"
    background #3f6da080
    style --compact --center --transparent
    range --show-value --status "Vertical field of view adjustment (legacy)." "screen size" viewsize 40 100 10
    toggle --status "Show a real-time graph of server latency." "ping graph" scr_lag_draw
    pairs --status "Show a subtle network history indicator." "network bar" sh_netmeter off 0 lagometer 1 netgraph 2 histogram 3
    toggle --status "Show short warnings for run-affecting network incidents." "network notice" sh_netalert
    values --status "Detailed recording status bar for demos." "demo bar" scr_demobar no yes verbose
    pairs --show-value --status "Text dump of frame/network errors." "turtle text" scr_showturtle off 0 normal 1 verbose 2
    range --show-value --status "Overall transparency of the in-game HUD." "HUD opacity" scr_alpha 0 1
    range --show-value --status "Transparency of the background console." "console opacity" con_alpha 0 1
    pairs --status "Scale factor for all HUD elements." "HUD scale" scr_scale auto 0 1x 1 2x 2 4x 4
    pairs --status "Scale factor for the console text." "console scale" con_scale auto 0 1x 1 2x 2 4x 4
    pairs --status "Scale factor for this menu system." "menu scale" ui_scale auto 0 1x 1 2x 2 4x 4
    pairs --status "Choose the menu source used after the next UI restart. Built-in ignores q2pro.menu; external file loads q2pro.menu overrides from disk." "menu source" ui_external_menu built-in 0 "external file" 1
    blank
    action --status "Adjust aiming cursor appearance." --align "crosshair setup..." pushmenu crosshair
    action --status "Configure jump-specific assist tools." --align "jump HUD setup..." pushmenu jump
end

begin downloads
    title "Download Options"
    background #3f6da080
    style --compact --center --transparent
    toggle --status "Global switch for automated server downloads." "allow downloading" allow_download
    toggle --status "Automatically fetch missing .bsp files." "maps" allow_download_maps --show-if allow_download !0
    toggle --status "Fetch custom player models and skins." "player models/skins" allow_download_players --show-if allow_download !0
    toggle --status "Fetch custom 3D map objects and entities." "models" allow_download_models --show-if allow_download !0
    toggle --status "Fetch custom weapon and ambient sounds." "sounds" allow_download_sounds --show-if allow_download !0
    toggle --status "Fetch high-res or custom world textures." "textures" allow_download_textures --show-if allow_download !0
    toggle --status "Fetch custom images, banners, and logos." "pics" allow_download_pics --show-if allow_download !0
    blank --show-if allow_download !0
    toggle --status "Use high-speed web downloads where available." "HTTP downloads" cl_http_downloads --show-if allow_download !0
end

begin jump
    title "Jump Setup"
    background #3f6da080
    style --compact --center --transparent --live
    blank
    action --status "Configure the visual strafe-assist bar." "strafe helper" pushmenu strafehelper
    action --status "Show your current speed (Units Per Second)." "UPS display" pushmenu jumpups
    action --status "Draw a trailing line behind your movement." "race line" pushmenu raceline
    action --status "Configure subtle network history indicator." "network bar" pushmenu jumpnetwork
    action --status "Configure on-screen network warning alerts." "network alerts" pushmenu jumpnetalerts
    action --status "Bind keys for mod-specific actions." "mod bindings" pushmenu jumpmodbinds
    action --status "Bind keys for quick FPS switching." "fps bindings" pushmenu jumpfpsbinds
    blank
    action --status "Technical settings and debug commands." "advanced/debug" pushmenu jumpdebug
end



begin jumpfpsbinds
    title "FPS Bindings"
    background #3f6da080
    style --compact --center --transparent

    bind --status "Bind key to set cl_maxfps to 20." "FPS 20" f20
    bind --status "Bind key to set cl_maxfps to 22." "FPS 22" f22
    bind --status "Bind key to set cl_maxfps to 25." "FPS 25" f25
    bind --status "Bind key to set cl_maxfps to 26." "FPS 26" f26
    bind --status "Bind key to set cl_maxfps to 31." "FPS 31" f31
    bind --status "Bind key to set cl_maxfps to 32." "FPS 32" f32
    bind --status "Bind key to set cl_maxfps to 33." "FPS 33" f33
    bind --status "Bind key to set cl_maxfps to 60." "FPS 60" f60
    bind --status "Bind key to set cl_maxfps to 66." "FPS 66" f66
    bind --status "Bind key to set cl_maxfps to 90." "FPS 90" f90
    bind --status "Bind key to set cl_maxfps to 100." "FPS 100" f100
    bind --status "Bind key to set cl_maxfps to 120." "FPS 120" f120
end


begin jumpmodbinds
    title "Mod Bindings"
    background #3f6da080
    style --compact --center --transparent

    static "[Movement / Storage]"
    bind --status "Saves current position and velocity." "store" store
    bind --status "Returns to your stored position." "recall" recall
    bind --status "Resets your current race run." "reset" reset
    bind --status "Fires the grappling hook." "hook" hook
    bind --status "Releases the grappling hook." "unhook" unhook
    blank

    static "[HUD / Information]"
    bind --status "Toggles the replay statistics display." "replay stats" repstats
    bind --status "Toggles jump distance announcement." "show jumps" showjumps
    bind --status "Toggles split times display." "show times" showtimes
    bind --status "Toggles checkpoint arrival sound." "checkpoint sound" cpsound
    bind --status "Shows current frames per second." "show FPS" !fps
    blank

    static "[Social / Team]"
    bind --status "Votes YES in current election." "vote yes" yes
    bind --status "Votes NO in current election." "vote no" no
    bind --status "Teleports you to a specific player." "goto player" goto
    bind --status "Toggles your idle/AFK state." "idle mode" idle
    bind --status "Joins the Easy difficulty team." "join easy" "team easy"
    bind --status "Joins the Hard difficulty team." "join hard" "team hard"
    bind --status "Moves you to the observer team." "spectate" observer
end

begin jumpkeys
    title "Jump Key Bindings"
    background #3f6da080
    style --compact --center --transparent
    bind --status "The primary jump action (+moveup)." "jump" +moveup
    bind --status "Double-jump script (+dj)." "double jump" +dj
    bind --status "Move downward or crouch (+movedown)." "crouch" +movedown
    bind --status "Move player forward (+forward)." "walk forward" +forward
    bind --status "Move player backward (+back)." "backpedal" +back
    bind --status "Side-step to the left (+moveleft)." "strafe left" +moveleft
    bind --status "Side-step to the right (+moveright)." "strafe right" +moveright
    bind --status "Return to the Jump Setup menu." "jump setup menu" "pushmenu jump"
    blank
    bind --status "Toggle the scoreboard (score)." "scoreboard" score
    bind --status "Toggle the race timer (time)." "timer" time
    bind --status "Show current map coordinates (coord)." "coordinates" coord
    bind --status "Compare your time with best (compare)." "compare" compare
    bind --status "Clear the HUD of temporary messages (cleanhud)." "clear HUD" cleanhud
    bind --status "Toggle visibility of other players (ghost)." "toggle ghost" ghost
end

begin strafehelper
    title "Strafe Helper"
    background #3f6da080
    style --compact --center --transparent --live
    toggle --show-value --status "Global switch for the strafe helper HUD element." "enabled" sh_draw
    toggle --show-value --status "Show a central mark for neutral mouse position." "center marker" sh_centermarker --show-if sh_draw !0
    range --show-value --status "Scale factor for the strafe helper bar." "scale" sh_scale 0.5 4.0 0.1 --show-if sh_draw !0
    range --show-value --status "Vertical position from the top of the screen." "Y position" sh_y 0 320 5 --show-if sh_draw !0
    range --show-value --status "Height of the strafe helper bar in pixels." "height" sh_height 4 80 1 --show-if sh_draw !0
    range --show-value --status "Transparency of the strafe helper bar." "alpha" sh_alpha 0 1 0.05 --show-if sh_draw !0
    strings --show-value --status "Visual drawing style of the strafe helper." "bar style" sh_bar_style gradient solid outline minimal --show-if sh_draw !0
    range --show-value --status "Smooth visual movement of strafe helper angles; 0 disables it." "smoothing" sh_smoothing 0 10 0.1 --show-if sh_draw !0
    pairs --show-value --status "Easing curve used by strafe helper smoothing." "smoothing mode" sh_smoothing_mode linear 1 quadratic 2 cubic 3 sine 4 exponential 5 --show-if sh_smoothing !0
    range --show-value --status "Width of the center mouse position marker." "center width" sh_center_width 0.1 5 0.1 --show-if sh_draw !0
    range --show-value --status "Width of the optimal acceleration zone." "optimal width" sh_optimal_width 0.1 5 0.1 --show-if sh_draw !0
    toggle --show-value --status "Draw the optimal angle marker as an outline." "optimal outline" sh_optimal_outline --show-if sh_draw !0
    field --picker --status "Color when mouse is within optimal zone." "accelerating color" sh_color_accelerating --show-if sh_draw !0
    field --picker --status "Color when moving at perfect angle." "optimal color" sh_color_optimal --show-if sh_draw !0
    field --picker --status "Color of the center neutral marker." "center marker color" sh_color_centermarker --show-if sh_draw !0
    blank --show-if sh_draw !0
    action --status "Choose from a set of pre-defined color schemes." --align "apply color preset..." pushmenu shpresets --show-if sh_draw !0
end

begin shpresets
    title "Strafe Helper Presets"
    background #3f6da080
    style --compact --center --transparent
    action --status "Apply a randomized color scheme." "random" "sh hud preset random"
    action --status "Original grey and blue theme." "vanilla" "sh hud preset vanilla"
    action --status "Calm blue and teal tones." "ocean" "sh hud preset ocean"
    action --status "Classic CRT orange and green." "retro" "sh hud preset retro"
    action --status "Neon pink and cyan aesthetic." "cyberpunk" "sh hud preset cyberpunk"
    action --status "Fresh green and white theme." "mint" "sh hud preset mint"
    action --status "Hot orange and red theme." "lava" "sh hud preset lava"
    action --status "Subtle dark and grey tones." "shadow" "sh hud preset shadow"
    action --status "List all available presets in the console." "show all presets" "sh hud preset"
end

begin jumpups
    title "UPS Display"
    background #3f6da080
    style --compact --center --transparent --live
    toggle --show-value --status "Show current movement speed (Units Per Second)." "enabled" sh_ups
    range --show-value --status "Scale factor for the speed digits." "scale" sh_ups_scale 0.25 4 0.25 --show-if sh_ups !0
    range --show-value --status "Vertical offset from screen center." "Y position" sh_ups_y -300 300 5 --show-if sh_ups !0
    toggle --show-value --status "Draw a drop-shadow behind the speed digits." "shadow" sh_ups_shadow --show-if sh_ups !0
    toggle --show-value --status "Hide the display when speed is zero." "hide zero" sh_ups_hide_zero --show-if sh_ups !0
    toggle --show-value --status "Include vertical velocity component in calculations." "3D speed" sh_ups_3d --show-if sh_ups !0
    strings --show-value --status "How speed changes affect text color." "color mode" sh_ups_color_mode dynamic static threshold rainbow gradient strafing --show-if sh_ups !0
    strings --show-value --status "Display speed as raw number or with label." "format" sh_ups_format plain suffix prefix --show-if sh_ups !0
    field --picker --status "Color used when gaining speed." "gain color" sh_ups_color_gain --show-if sh_ups !0
    field --picker --status "Color used when losing speed." "loss color" sh_ups_color_loss --show-if sh_ups !0
    field --picker --status "Color used when at constant speed." "neutral color" sh_ups_color_neutral --show-if sh_ups !0
end


begin raceline
    title "Race Line"
    background #3f6da080
    style --compact --center --transparent --live
    range --show-value --status "Thickness of the movement trail line." "width" race_width 0 20 1
    range --show-value --status "Opacity level of the movement trail." "opacity" race_alpha 0 1 0.05
    range --show-value --status "Duration before the line fades away (ms)." "lifetime (ms)" race_life 0 5000 100
    field --picker --status "Color of the movement trail line." "line color" race_color
end

begin jumpnetwork
    title "Jump Network"
    background #3f6da080
    style --compact --center --transparent --live
    static "[Run Feedback]"
    pairs --show-value --status "Localized network status indicator." "network bar" sh_netmeter off 0 lagometer 1 netgraph 2 histogram 3
    pairs --show-value --status "Scale netmeter dynamically based on recent latency baseline." "adaptive scaling" sh_netmeter_adaptive off 0 on 1 --show-if sh_netmeter !0
    range --show-value --status "Minimum latency scaling threshold in milliseconds." "min latency" sh_netmeter_min_ms 0 1000 10 --show-if sh_netmeter_adaptive 0
    range --show-value --status "Maximum latency scaling threshold in milliseconds." "max latency" sh_netmeter_max_ms 0 1000 10 --show-if sh_netmeter_adaptive 0
    blank --show-if sh_netmeter !0

    static "[Lagometer Layout]" --show-if sh_netmeter 1
    range --show-value --status "Horizontal offset; negative values align from the right edge." "X position" sh_lagometer_x -640 640 1 --show-if sh_netmeter 1
    range --show-value --status "Vertical offset; negative values align from the bottom edge." "Y position" sh_lagometer_y -480 480 1 --show-if sh_netmeter 1
    range --show-value --status "Opacity of normal samples; lower values keep stable network almost invisible." "normal alpha" sh_lagometer_alpha 0 1 0.05 --show-if sh_netmeter 1
    range --show-value --status "Opacity of loss/stall/prediction samples." "incident alpha" sh_lagometer_bad_alpha 0 1 0.05 --show-if sh_netmeter 1
    blank --show-if sh_netmeter 1
    static "[Lagometer Theme & Colors]" --show-if sh_netmeter 1
    range --show-value --status "Normal packet color palette index." "normal color" sh_lagometer_color_normal 0 255 1 --show-if sh_netmeter 1
    range --show-value --status "Ping spike color palette index." "spike color" sh_lagometer_color_spike 0 255 1 --show-if sh_netmeter 1
    range --show-value --status "Ping jitter color palette index." "jitter color" sh_lagometer_color_jitter 0 255 1 --show-if sh_netmeter 1
    range --show-value --status "Incoming (Server-to-Client) packet loss color palette index." "S2C loss color" sh_lagometer_color_loss_s2c 0 255 1 --show-if sh_netmeter 1
    range --show-value --status "Outgoing (Client-to-Server) packet loss color palette index." "C2S loss color" sh_lagometer_color_loss_c2s 0 255 1 --show-if sh_netmeter 1
    blank --show-if sh_netmeter 1

    static "[Netgraph Layout]" --show-if sh_netmeter 2
    range --show-value --status "Bar height in HUD pixels." "height" sh_netgraph_height 1 120 1 --show-if sh_netmeter 2
    range --show-value --status "Vertical offset; negative values align from the bottom edge." "Y position" sh_netgraph_y -480 480 1 --show-if sh_netmeter 2
    blank --show-if sh_netmeter 2
    static "[Netgraph Theme & Colors]" --show-if sh_netmeter 2
    range --show-value --status "Normal packet color palette index." "normal color" sh_netgraph_color_normal 0 255 1 --show-if sh_netmeter 2
    range --show-value --status "Ping spike color palette index." "spike color" sh_netgraph_color_spike 0 255 1 --show-if sh_netmeter 2
    range --show-value --status "Ping jitter color palette index." "jitter color" sh_netgraph_color_jitter 0 255 1 --show-if sh_netmeter 2
    range --show-value --status "Incoming (Server-to-Client) packet loss color palette index." "S2C loss color" sh_netgraph_color_loss_s2c 0 255 1 --show-if sh_netmeter 2
    range --show-value --status "Outgoing (Client-to-Server) packet loss color palette index." "C2S loss color" sh_netgraph_color_loss_c2s 0 255 1 --show-if sh_netmeter 2
    blank --show-if sh_netmeter 2

    static "[Histogram Layout]" --show-if sh_netmeter 3
    range --show-value --status "Bar height in HUD pixels." "height" sh_histogram_height 1 120 1 --show-if sh_netmeter 3
    range --show-value --status "Bar width in HUD pixels." "width" sh_histogram_width 10 640 10 --show-if sh_netmeter 3
    range --show-value --status "Horizontal offset; negative values align from the right edge." "X position" sh_histogram_x -640 640 1 --show-if sh_netmeter 3
    range --show-value --status "Vertical offset; negative values align from the bottom edge." "Y position" sh_histogram_y -480 480 1 --show-if sh_netmeter 3
    range --show-value --status "Opacity of normal samples; lower values keep stable network almost invisible." "normal alpha" sh_histogram_alpha 0 1 0.05 --show-if sh_netmeter 3
    range --show-value --status "Opacity of loss/stall/prediction samples." "incident alpha" sh_histogram_bad_alpha 0 1 0.05 --show-if sh_netmeter 3
    range --show-value --status "How much recent history the bar represents, in milliseconds." "history ms" sh_histogram_history_ms 500 120000 1000 --show-if sh_netmeter 3
    toggle --show-value --status "Draw current ping value over the histogram." "ping display" sh_histogram_ping --show-if sh_netmeter 3
    blank --show-if sh_netmeter 3

    static "[Histogram Theme & Colors]" --show-if sh_netmeter 3
    range --show-value --status "Histogram background opacity level." "background alpha" sh_histogram_bg_alpha 0 1 0.05 --show-if sh_netmeter 3
    range --show-value --status "Histogram background color palette index." "background color" sh_histogram_color_bg 0 255 1 --show-if sh_netmeter 3
    range --show-value --status "Normal packet color palette index." "normal color" sh_histogram_color_normal 0 255 1 --show-if sh_netmeter 3
    range --show-value --status "Ping spike color palette index." "spike color" sh_histogram_color_spike 0 255 1 --show-if sh_netmeter 3
    range --show-value --status "Ping jitter color palette index." "jitter color" sh_histogram_color_jitter 0 255 1 --show-if sh_netmeter 3
    range --show-value --status "Incoming (Server-to-Client) packet loss color palette index." "S2C loss color" sh_histogram_color_loss_s2c 0 255 1 --show-if sh_netmeter 3
    range --show-value --status "Outgoing (Client-to-Server) packet loss color palette index." "C2S loss color" sh_histogram_color_loss_c2s 0 255 1 --show-if sh_netmeter 3
    blank --show-if sh_netmeter 3

    action --status "Configure latency and loss warning thresholds." "threshold settings" pushmenu jumpnetthresholds
    blank

    static "[Legacy / Debug]"
    toggle --show-value --status "Original small 48x48 ping graph." "ping graph" scr_lag_draw
    pairs --show-value --status "Original ping graph, or new detailed ribbon for high-ping servers." "netgraph" netgraph off 0 ping 1 ribbon 2
end

begin jumpnetalerts
    title "Network Alerts"
    background #3f6da080
    style --compact --center --transparent --live
    static "[Notice Feedback]"
    toggle --show-value --status "Short warning text for incidents likely to affect a run." "incident notice" sh_netalert
    blank --show-if sh_netalert !0

    static "[Notice Layout]" --show-if sh_netalert !0
    range --show-value --status "Incident notice horizontal offset." "notice X" sh_netalert_x -640 640 1 --show-if sh_netalert !0
    range --show-value --status "Incident notice vertical offset; negative values align from the bottom edge." "notice Y" sh_netalert_y -480 480 1 --show-if sh_netalert !0
    range --show-value --status "Alert text color code (1=red, 2=green, 3=yellow, 4=blue, 5=cyan, 6=magenta, 7=severity-based, 8=orange, 9=purple)." "notice color" sh_netalert_color 1 9 1 --show-if sh_netalert !0
    range --show-value --status "How long incident text stays visible, in milliseconds." "notice ms" sh_netalert_duration_ms 250 5000 250 --show-if sh_netalert !0
    range --show-value --status "Opacity of incident notice text." "notice alpha" sh_netalert_alpha 0 1 0.05 --show-if sh_netalert !0
    blank --show-if sh_netalert !0

    static "[Notice Types]" --show-if sh_netalert !0
    toggle --show-value --status "Show notice for dropped packets." "loss notice" sh_netalert_loss --show-if sh_netalert !0
    toggle --show-value --status "Show notice for repeated ping wobble." "jitter notice" sh_netalert_jitter --show-if sh_netalert !0
    toggle --show-value --status "Show notice for sudden ping jumps." "spike notice" sh_netalert_spike --show-if sh_netalert !0
    blank --show-if sh_netalert !0

    action --status "Configure latency and loss warning thresholds." "threshold settings" pushmenu jumpnetthresholds --show-if sh_netalert !0
    blank --show-if sh_netalert !0
end

begin jumpnetthresholds
    title "Network Thresholds"
    background #3f6da080
    style --compact --center --transparent --live

    static "[Latency Thresholds]"
    toggle --show-value --status "Compare spikes and jitter against your current ping baseline; recommended for distant servers." "adaptive ping" sh_netwarn_ping_adaptive
    range --show-value --status "Minimum sudden ping jump before a spike warning." "spike ms" sh_netwarn_spike_ms 0 300 5 --show-if sh_netwarn_ping_adaptive 0
    range --show-value --status "Adaptive spike threshold as percent of your rolling ping baseline." "spike pct" sh_netwarn_spike_pct 0 100 5 --show-if sh_netwarn_ping_adaptive 1
    range --show-value --status "Repeated ping wobble threshold before jitter warning." "jitter ms" sh_netwarn_jitter_ms 0 150 5
    blank
end

begin replayrecording
    title "Replay Recording"
    background #3f6da080
    style --compact --center --transparent --live
    action --status "Start recording a new movement replay." "start recording" "sh record"
    action --status "Stop the current recording session." "stop recording" "sh stop"
    action --status "Play back a saved movement replay." "play replay" "sh play"
end

begin jumpdebug
    title "Jump Debug"
    background #3f6da080
    style --compact --center --transparent --live
    pairs --status "Diagnostic overlay for movement physics." "NerdStats" sh_nerdstats off 0 left 1 right 2
    action --status "Output physics state to the console." --align "dump physics now" debugnow
    action --status "Report current strafe helper internal state." --align "show strafe helper status" "sh status"
    action --status "List all active jump-mod commands." --align "show commands" commands
    action --status "Display list of players on the server." --align "show jumpers" jumpers
    action --status "Show jump details and statistics." --align "show jumps" showjumps
end

begin gameflags
    title "Deathmatch Flags"
    background #3f6da080
    style --compact --center --transparent
    toggle --status "Enable damage when falling from heights." "falling damage" dmflags ~3
    toggle --status "Weapons remain on the map after pickup." "weapons stay" dmflags 2
    toggle --status "Powerups take effect immediately on pickup." "instant powerups" dmflags 4
    toggle --status "Allow standard powerups to spawn." "allow powerups" dmflags ~1
    toggle --status "Allow health items to spawn." "allow health" dmflags ~0
    toggle --status "Allow armor items to spawn." "allow armor" dmflags ~11
    toggle --status "Players spawn at most distant points." "spawn farthest" dmflags 9
    toggle --status "Restart same map when match ends." "same map" dmflags 5
    toggle --status "Force players to respawn immediately." "force respawn" dmflags 10
    toggle --status "Players have unlimited ammunition." "infinite ammo" dmflags 13
    toggle --status "Lock field of view for all players." "fixed FOV" dmflags 15
    toggle --status "Quad Damage is dropped on death." "quad drop" dmflags 14
end

begin startserver
    //title "Start Server"
    banner m_banner_start_server
    strings --status "Select the map to load on startup." "initial map" _ui_nextserver $$com_maplist
    values --status "Select the basic game ruleset." "rules" coop deathmatch cooperative
    field --integer --status "Duration of a single match in minutes (0 = none)." --width 3 "time limit" timelimit
    field --integer --status "Frag count required to end match (0 = none)." --width 3 "frag limit" fraglimit
    field --integer --status "Maximum number of simultaneous players." --width 3 "max players" maxclients
    field --width 16 --status "Display name of your server." "host name" hostname
    blank
    action --status "Fine-tune competitive match rules." --align "deathmatch flags..." pushmenu gameflags
    action --status "Initialize and launch the server." --align "begin game!" "forcemenuoff; if $coop == 1 then deathmatch 0 else deathmatch 1; map $_ui_nextserver force"
end

begin multiplayer
    title "Multiplayer"
    background #3f6da080
    style --compact --center --transparent
    action --status "Browse all active Quake 2 servers." "browse q2servers.com" pushmenu servers "+http://q2servers.com/?raw=2"
    action --status "Find active jump and race servers." "browse jump servers" pushmenu servers "@jump +http://q2servers.com/?raw=2&mod=jump"
    action --status "Quick access to your saved servers." "browse address book" pushmenu servers "favorites://" "file:///servers.lst" "broadcast://"
    action --status "Watch recorded match and jump replays." "browse demos" pushmenu demos
    action --status "Host a local or dedicated server." "start server" pushmenu startserver
end

begin main
    title "Main Menu"
    background #3f6da080
    style --compact --center --transparent
    action --status "Find and join online games." "multiplayer" pushmenu multiplayer
    action --status "Engine and gameplay configuration." "options" pushmenu options
    action --status "Display and resolution settings." "video setup" pushmenu video
    blank
    action --status "Exit the game." "quit" quit
end

begin game
    title "In-Game Menu"
    background #3f6da080
    style --compact --center --transparent
    action --status "Configure HUD and jump tools." "jump setup" pushmenu jump
    blank
    action --status "Find active jump and race servers." "browse jump servers" pushmenu servers "@jump +http://q2servers.com/?raw=2&mod=jump"
    action --status "Quick access to your saved servers." "browse address book" pushmenu servers "favorites://" "file:///servers.lst" "broadcast://"
    action --status "Watch recorded match and jump replays." "browse demos" pushmenu demos
    action --status "Engine and gameplay configuration." "options" pushmenu options
    blank
    action --status "Leave the current server." "disconnect" disconnect
    action --status "Exit the game." "quit" quit
end

