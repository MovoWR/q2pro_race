    blank
    static "[Notice Layout]"
    range --show-value --status "Incident notice horizontal offset." "notice X" sh_netalert_x -640 640 1
    range --show-value --status "Incident notice vertical offset; negative values align from the bottom edge." "notice Y" sh_netalert_y -480 480 1
    range --show-value --status "Alert text color code (1=red, 2=green, 3=yellow, 4=blue, 5=cyan, 6=magenta, 7=severity-based, 8=orange, 9=purple)." "notice color" sh_netalert_color 1 9 1
    range --show-value --status "How long incident text stays visible, in milliseconds." "notice ms" sh_netalert_duration_ms 250 5000 250
    range --show-value --status "Opacity of incident notice text." "notice alpha" sh_netalert_alpha 0 1 0.05
    blank
