/*
This is example menu definition file for Q2PRO.

File format is line based, whitespace is ignored.  C and C++ style comments are
supported.  Long lines can be broken into multiple ones by escaping linefeed
characters with backslashes.

Lines are macro expanded at script load time just as usual console commands.
Any cvars and macros can be referenced.

Maximum line length after expansion is limited to 1024 chars (this is Q2
command line parser limitation). Menu items of spin control type (‘values’ and
‘strings’) support special hack that avoids 1024 chars limit by performing
expansion after command line is parsed: prefix cvar name to be expanded with
"$$" instead of "$".

Duplicate menu entries override previous ones.  Built-in menus (‘demos’,
‘servers’ and ‘players’) can not be overridden.  When user presses ESC while
disconnected, ‘main’ menu is pushed.  When user presses ESC while spawned in
game, ‘game’ menu is pushed if it is found, otherwise ‘main’ menu is pushed.

Supported keywords and their syntax:

include <filename>

background <color|image>
font <image>
cursor <image>
weapon <model>
style [--compact|--no-compact] [--left|--center|--right] [--transparent|--no-transparent] [--live|--no-live]
focus [--fullwidth|--menuwidth] [--border <pixels>|--no-border] [--inset <pixels>] [--height <pixels>]

color <state> <color>

begin <menuname>
   title <menutitle>
   banner <image>
   background <color|image>
   plaque <plaque> [logo]
   style [--compact|--no-compact] [--left|--center|--right] [--transparent|--no-transparent] [--live|--no-live]
   focus [--fullwidth|--menuwidth] [--border <pixels>|--no-border] [--inset <pixels>] [--height <pixels>]

   range [--show-value] [--status <text>] <name> <cvar> <min> <max> [step]

   pairs [--show-value] [--status <text>] <name> <cvar> <string1> <value1> [...]
   values [--show-value] [--status <text>] <name> <cvar> <string1> [...]
   strings [--show-value] [--status <text>] <name> <cvar> <value1> [...]
   toggle [--show-value] [--status <text>] <name> <cvar> [~][bit]

   bind [--align] [--status <text>] [--altstatus <text>] <name> <command>
   action [--align] [--status <text>] <name> <command>
   bitmap <image> <command>
   savegame <slot>
   loadgame <slot>
   blank

   field [--center] [--color|--picker] [--integer|--numeric] [--status <text>] [--width <chars>] <name> <cvar>
end

Virtual --show-if cvars: ui_exclusive_fullscreen, ui_borderless_or_windowed,
ui_histogram_custom_width.
*/

background #3f6da070
font prochars
cursor ch1
weapon w_railgun.md2
style --compact --center --transparent

color normal    #ffffffff
color selectable #ffffffff
color alternate #ffffffff
color title     #aa4651ff
color active     #3f6da0ff
color selection  #aa4651ff
color focus      #5a5f6666
color focus_border #b8bec8aa
color disabled   #aa4651ff

begin video
    title "Video - Display"
    style --live
    values --show-value --status "Switch between fullscreen and windowed modes." "video mode" vid_fullscreen windowed $$vid_modelist
    toggle --show-value --status "Use a borderless window. With fullscreen enabled, this becomes borderless fullscreen." "borderless" vid_noborder
    toggle --show-value --status "Synchronize frame rate with monitor refresh to prevent tearing." "vertical sync" gl_swapinterval
    action "Graphics settings..." pushmenu video_graphics
end

begin video_graphics
    title "Graphics"
    style --live
    pairs --show-value --status "Smooth jagged edges of geometry." "anti-aliasing" gl_multisamples no 0 "2x MSAA" 2 "4x MSAA" 4 "8x MSAA" 8
    range --show-value --status "Lower values increase texture detail." "texture quality" gl_picmip 3 0 -1
    pairs --status "Choose between classic pixelated or modern smooth textures." "texture filter" gl_texturemode \
        nearest GL_NEAREST \
        linear GL_LINEAR \
        bilinear GL_LINEAR_MIPMAP_NEAREST \
        trilinear GL_LINEAR_MIPMAP_LINEAR
    pairs --show-value --status "Improve texture clarity on surfaces viewed at an angle." "anisotropic filter" gl_anisotropy no 1 2x 2 4x 4 8x 8 16x 16
    values --show-value --status "Adjust how Field of View is calculated for wide screens." "fov scaling" cl_adjustfov vert- hor+
    blank
    action "Brightness and color..." pushmenu video_color
    action "Advanced rendering..." pushmenu video_advanced
end

begin video_color
    title "Brightness and Color"
    style --live
    range --show-value --status "Adjust the brightness balance of game textures." "texture gamma" vid_gamma 1.3 0.3
    range --show-value --status "Adjust the color intensity of game world textures." "texture saturation" gl_saturation 0 1
    range --show-value --status "Boost the overall brightness of textures." "texture intensity" intensity 1 3 0.1
    range --show-value --status "Scale opaque lava brightness without changing other textures (shader renderer only)." "lava brightness" gl_lava_intensity 0.1 3 0.1 --show-if gl_shaders !0
    range --show-value --status "Adjust the color intensity of static lightmaps." "lightmap saturation" gl_coloredlightmaps 0 1
    range --show-value --status "Fine-tune the brightness of static lighting." "lightmap brightness" gl_brightness 0 0.3
end

begin video_advanced
    title "Advanced Rendering"
    values --status "Legacy GL1.x vs Modern GL3.x shaders." "rendering backend" gl_shaders legacy shaders
    toggle --show-value --status "Toggle use of monitor hardware for gamma correction." "hardware gamma" vid_hwgamma

    toggle --status "Draw skybox textures (disable to draw black sky)." "draw skybox" gl_drawsky
    toggle --status "Bilinear filtering of skybox textures." "sky filtering" gl_bilerp_skies
    pairs --status "HQ upscale filter for PCX images (improves scaled HUD elements)." "HUD image upscale" gl_upscale_pcx no 0 2x 1 4x 2
    pairs --status "Bilinear filtering level for HUD pictures." "HUD image filter" gl_bilerp_pics off 0 "large only" 1 all 2
    pairs --status "Draw drop-shadow under text to improve readability." "text shadow" gl_fontshadow no 0 1px 1 2px 2
    toggle --status "Bilinear filtering of console and menu text." "text filtering" gl_bilerp_chars
    pairs --status "Search for truecolor replacements (PNG/JPG/TGA) for game textures." "texture override" r_override_textures off 0 "palettized only" 1 all 2
    values --status "File format used when taking screenshots." "screenshot format" gl_screenshot_format jpg png tga
    blank
end

begin options
    title "Options"

    action --status "Customize your player name and appearance." "player setup" pushmenu players
    action --status "Configure jump-specific HUD and assist tools." "Jump Settings" pushmenu jump
    action --status "Adjust mouse sensitivity and input settings." "input setup" pushmenu input
    action --status "Bind movement and game actions to keys." "key bindings" pushmenu keys
    action --status "Graphics, resolution, and quality settings." "video setup" pushmenu video
    action --status "Audio levels and engine settings." "sound setup" pushmenu sound
    action --status "Explosions, shadows, and rail trails." "effects setup" pushmenu effects
    action --status "HUD size, opacity, and scaling." "screen setup" pushmenu screen
    action --status "Menu scale, style, source, and cursor settings." "menu setup" pushmenu menusetup
    action --status "Asset downloading preferences." "download options" pushmenu downloads
    action --status "Quick-connect address book." "address book" pushmenu addressbook
end

begin sound
    title "Sound Setup"

    values --status "Select the audio output engine (OpenAL recommended)." "sound engine" s_enable "no sound" "software" "OpenAL"
    range --show-value --status "Lower values reduce delay but may cause stuttering." "sound latency" s_mixahead 0.05 0.2 --show-if s_enable !0
    range --show-value --status "Overall volume of sound effects and voices." "effects volume" s_volume 0 1 --show-if s_enable !0
    range --show-value --status "Volume level for background OGG music." "music volume" ogg_volume 0 1 --show-if ogg_enable !0
    toggle --status "Enable or disable background music playback." "enable music" ogg_enable --show-if s_enable !0
    toggle --status "Play music tracks in random order." "shuffle tracks" ogg_shuffle --show-if ogg_enable !0
    toggle --status "Apply a muffled audio filter when submerged." "underwater effect" s_underwater --show-if s_enable !0
    values --status "Ambient map sounds like wind or humming machinery." "ambient sounds" s_ambient "no" "yes" "only player's own" --show-if s_enable !0
    toggle --status "Suppress jump voice sounds from all players." "mute player jump sounds" s_mute_player_jump_sounds --show-if s_enable !0
    values --status "Sound notification when receiving a chat message." "chat beep" cl_chat_sound "disabled" "default" "alternative" --show-if s_enable !0
    blank
    toggle --status "Automatically mute sound when game window loses focus." "mute when inactive" s_auto_focus
    toggle --status "Swap left and right audio channels." "swap stereo channels" s_swapstereo --show-if s_enable !0
    pairs --status "Allow OpenAL Soft HRTF mixing for spatial 3D audio." "spatial audio (HRTF)" al_hrtf off 0 default 1 on 2 --show-if s_enable 2
end

begin railtrail
    title "Railgun Trail Setup"

    values --status "Visual style of the railgun beam." "rail trail type" cl_railtrail_type \
        "default" "core only" "core and spiral"
    range --show-value --status "How long the trail remains visible in seconds." "rail trail duration" cl_railtrail_time 0.1 3.0 0.1
    range --show-value --status "Thickness of the inner beam." "core width" cl_railcore_width 1 6 1
    range --show-value --status "Spiral radius of the outer effect." "spiral radius" cl_railspiral_radius 1 6 1
    strings --status "Color of the inner beam." "core color" cl_railcore_color \
        black red green yellow blue cyan magenta white
    strings --status "Color of the outer spiral." "spiral color" cl_railspiral_color \
        black red green yellow blue cyan magenta white
end

begin effects
    title "Effects Setup"

    values --status "World lighting from projectiles and explosions." "dynamic lighting" gl_dynamic "no" "yes" "only switchable"
    values --status "Cartoon-style thick outlines on players and items." "entity cel-shading" gl_celshading no 1x 2x 3x
    toggle --status "Enable glowing shell around certain entities." "entity glowing" cl_noglow ~
    values --status "Drop-shadows under players and objects." "ground shadows" gl_shadows no yes fade
    toggle --status "Screen tinting from items and environment (lava/water)." "screen blending" gl_polyblend
    toggle --status "Visual distortion effect when underwater." "screen warping" gl_waterwarp
    toggle --status "Show or hide grenade explosion effects." "grenade explosions" cl_disable_explosions ~0
    toggle --status "Show or hide rocket explosion effects." "rocket explosions" cl_disable_explosions ~1
    toggle --status "Toggle dynamic lighting muzzle flashes." "muzzle flashes" cl_muzzleflashes
    toggle --status "Toggle weapon muzzle flash flare effects." "weapon flares" cl_flares
    toggle --status "Toggle rendering of body parts and blood splatters." "blood and gibs" cl_gibs
    toggle --status "Disable rendering of all particle effects." "disable particles" cl_disable_particles
    toggle --status "Toggle screen hit markers on successful shots." "hit markers" cl_hit_markers
    blank
    toggle --status "Toggles gun model bobbing when moving." "weapon bobbing" cl_nobob ~
    range --show-value --status "Transparency of the player gun model." "weapon opacity" cl_gunalpha 0 1
    range --show-value --status "Field of view for the player weapon model (0 uses main FOV)." "weapon FOV" cl_gunfov 0 120 5
    blank
    action --status "Customize railgun beam colors and style." --align "railgun trail setup..." pushmenu railtrail
end

begin crosshair
    title "Crosshair Setup"

    values --status "Style of the center-screen aiming cursor." "crosshair type" crosshair none cross dot angle
    pairs --status "Change the physical size of the crosshair." "crosshair scale" ch_scale 0.5x 0.5 1x 1 2x 2 --show-if crosshair !0
    toggle --status "Change crosshair color based on player health." "color by health" ch_health --show-if crosshair !0
    range --show-value --status "Red intensity of the crosshair color." "red channel" ch_red 0 1 --show-if crosshair !0
    range --show-value --status "Green intensity of the crosshair color." "green channel" ch_green 0 1 --show-if crosshair !0
    range --show-value --status "Blue intensity of the crosshair color." "blue channel" ch_blue 0 1 --show-if crosshair !0
    range --show-value --status "Opacity level of the crosshair." "alpha channel" ch_alpha 0 1 --show-if crosshair !0
end

begin screen
    title "Screen Setup"

    range --show-value --status "Vertical field of view adjustment (legacy)." "screen size" viewsize 40 100 10
    toggle --status "Show a real-time graph of server latency." "ping graph" scr_lag_draw
    pairs --status "Show a subtle network history indicator." "network bar" sh_netmeter off 0 lagometer 1 netgraph 2 histogram 3
    toggle --status "Show short warnings for run-affecting network incidents." "network notice" sh_netalert
    values --status "Detailed recording status bar for demos." "demo bar" scr_demobar no yes verbose
    pairs --show-value --status "Text dump of frame/network errors." "turtle text" scr_showturtle off 0 normal 1 verbose 2
    range --show-value --status "Overall transparency of the in-game HUD." "HUD opacity" scr_alpha 0 1
    range --show-value --status "Transparency of the background console." "console opacity" con_alpha 0 1
    pairs --status "Scale factor for all HUD elements." "HUD scale" scr_scale auto 0 1x 1 2x 2 4x 4
    pairs --status "Scale factor for the console text." "console scale" con_scale auto 0 1x 1 2x 2 4x 4
    blank
    toggle --status "Show digital clock in the console." "console clock" con_clock
    range --show-value --status "Fraction of the screen height the console occupies." "console height" con_height 0.1 1.0
    blank
    action --status "Adjust aiming cursor appearance." --align "crosshair setup..." pushmenu crosshair
    action --status "Configure jump-specific assist tools." --align "Jump Settings" pushmenu jump
end

begin menusetup
    title "Menu Setup"

    style --live
    pairs --status "Scale factor for this menu system." "menu scale" ui_scale auto 0 1x 1 2x 2 4x 4
    pairs --show-value --status "Choose the menu color preset, or use your own custom palette." "color style" ui_menu_style classic 0 slate 1 custom 2
    action --status "Adjust the custom menu palette." --align "custom colors..." pushmenu menu_colors --show-if ui_menu_style 2
    values --status "Change OS cursor style for windowed and borderless menus." "system cursor" win_menu_cursor arrow cross hand ibeam wait no size --show-if ui_borderless_or_windowed 1
    field --status "Optional path to a menu background overlay image." "bar background image" ui_menu_bar_image
    range --show-value --status "Alpha/transparency of the menu bar overlay image." "bar overlay alpha" ui_menu_bar_image_alpha 0 1
    strings --status "Display mode for the menu bar overlay image." "bar overlay mode" ui_menu_bar_image_mode cover contain screen stretch fill
    values --status "Texture cursor used in exclusive fullscreen menus." "menu cursor texture" cl_menu_cursor none cross dot angle ch4 ch5 --show-if ui_exclusive_fullscreen 1
    pairs --status "Choose the menu source used after the next UI restart. Built-in is available only when game is jump; other games load q2pro.menu." "menu source" ui_external_menu built-in 0 "external file" 1
end

begin menu_colors
    title "Custom Menu Colors"

    style --live
    blank
    field --picker --status "Whole menu panel background." "panel background" ui_menu_color_panel_bg
    field --picker --status "Panel outline border." "panel border" ui_menu_color_panel_border
    field --picker --status "Panel drop shadow." "panel shadow" ui_menu_color_panel_shadow
    blank
    field --picker --status "Top menu title text." "title text" ui_menu_color_title_text
    field --picker --status "Default menu text." "normal text" ui_menu_color_text
    field --picker --status "Left-side labels and secondary text." "label text" ui_menu_color_label_text
    field --picker --status "Unavailable item text." "disabled text" ui_menu_color_disabled_text
    blank
    field --picker --status "Unfocused selectable item text." "item text" ui_menu_color_item_text
    field --picker --status "Text on the currently focused control." "focused text" ui_menu_color_focus_text
    field --picker --status "Focused row background marker." "focused row" ui_menu_color_focus_bg
    field --picker --status "Focused row side edge." "focused row edge" ui_menu_color_focus_edge
    field --picker --status "Focused item triangle marker." "focus marker" ui_menu_color_focus_marker
    blank
    field --picker --status "Value column/right-side text." "value text" ui_menu_color_value_text
    field --picker --status "Focused value column text." "active value text" ui_menu_color_value_active_text
    field --picker --status "Modified/unsaved value text." "changed value text" ui_menu_color_value_changed_text
    blank
    field --picker --status "Slider background track." "slider track" ui_menu_color_slider_track
    field --picker --status "Slider active progress fill." "slider fill" ui_menu_color_slider_fill
    field --picker --status "Slider active thumb/knob." "slider thumb" ui_menu_color_slider_thumb
    field --picker --status "Slider active thumb outline/border." "slider border" ui_menu_color_slider_border
    blank
    field --picker --status "List column header background." "list header" ui_menu_color_list_header_bg
    field --picker --status "Sorted list column header background." "sorted list header" ui_menu_color_sorted_header_bg
    field --picker --status "Selected row background in lists." "selected row" ui_menu_color_selection_bg
    field --picker --status "Scrollbar background track." "scrollbar track" ui_menu_color_scrollbar_track
    blank
    field --picker --status "Tab text in server browser." "tab text" ui_menu_color_tab_text
    field --picker --status "Active tab text in server browser." "active tab text" ui_menu_color_tab_active_text
    field --picker --status "Active tab background box in server browser." "active tab background" ui_menu_color_tab_active_bg
    field --picker --status "Inactive tab background box in server browser." "inactive tab background" ui_menu_color_tab_inactive_bg
    field --picker --status "Line under active server browser tab." "tab underline" ui_menu_color_tab_underline
    blank
    field --picker --status "Bottom hint bar background." "hint background" ui_menu_color_hint_bg
    field --picker --status "Bottom hint bar text." "hint text" ui_menu_color_hint_text
    blank
    action --status "Restore all custom menu colors to their default slate palette values." --align "reset custom colors" ui_reset_menu_colors
end

begin downloads
    title "Download Options"

    toggle --status "Global switch for automated server downloads." "allow downloading" allow_download
    toggle --status "Automatically fetch missing .bsp files." "maps" allow_download_maps --show-if allow_download !0
    toggle --status "Fetch custom player models and skins." "player models/skins" allow_download_players --show-if allow_download !0
    toggle --status "Fetch custom 3D map objects and entities." "models" allow_download_models --show-if allow_download !0
    toggle --status "Fetch custom weapon and ambient sounds." "sounds" allow_download_sounds --show-if allow_download !0
    toggle --status "Fetch high-res or custom world textures." "textures" allow_download_textures --show-if allow_download !0
    toggle --status "Fetch custom images, banners, and logos." "pics" allow_download_pics --show-if allow_download !0
    blank --show-if allow_download !0
    toggle --status "Use high-speed web downloads where available." "HTTP downloads" cl_http_downloads --show-if allow_download !0
end

begin jump
    title "Jump Setup"
    focus --menu-width

    style --live
    action --status "Configure the strafe helper, efficiency, speedometer, race line and bind reminders." "HUD & Visuals" pushmenu jumphud
    action --status "Set movement, JumpMod action and FPS bindings." "Controls & FPS" pushmenu jumpcontrols
    action --status "Configure network indicators, warnings and advanced settings." "Network & Advanced" pushmenu jumpnetsetup
    blank
    action --status "Arrange jump overlays with the mouse." "Edit HUD Layout" hud_edit --show-if game jump
end

begin jumphud
    title "HUD & Visuals"
    focus --menu-width

    action --status "Configure the visual strafe-assist bar." "Strafe Helper" pushmenu strafehelper
    action --status "Customize the airborne acceleration-efficiency display." "Efficiency Display" pushmenu shefficiency
    action --status "Configure your movement speed display." "Speedometer" pushmenu jumpups
    action --status "Style race lines sent by Jump servers." "Race Line" pushmenu raceline
    action --status "Choose which key bindings to show on the HUD." "Bind Reminders" pushmenu bindreminders
end

begin jumpcontrols
    title "Controls & FPS"
    focus --menu-width

    action --status "Bind keys for movement and menu navigation." "Movement & Menu Bindings" pushmenu jumpkeys
    action --status "Bind keys for JumpMod actions." "Jump Action Bindings" pushmenu jumpmodbinds
    action --status "Bind FPS preset keys and hold/release FPS keys." "FPS Controls" pushmenu jumpfpssetup
end

begin bindreminders
    title "Bind Reminders"
    focus --menu-width

    style --live
    toggle --show-value --status "Show a dim list of your selected keys and actions." "enabled" scr_bindreminders_visible
    toggle --show-value --status "Automatically list loaded cl_maxfps binds, FPS shortcuts and aliases." "detect FPS binds" scr_bindreminders_fps
    range --show-value --status "Reminder opacity, multiplied by overall HUD opacity." "opacity" scr_bindreminders_alpha 0 1 0.05
    action --status "Move, hide or show the Bind reminders element." "edit HUD layout" hud_edit --show-if game jump
    blank
    action --status "Show reminders for menu, respawn, store and observer." "extended reminders" pushmenu bindremindersextended
    action --status "Choose extra reminders or override a detected FPS caption." "extra reminders 1-4" pushmenu bindreminders1
    action --status "Add more reminders for actions such as store and recall." "extra reminders 5-8" pushmenu bindreminders2
    blank
    action --status "Assign keys for instant FPS changes." "FPS Preset Bindings" pushmenu jumpfpsbinds
    action --status "Assign keys for store, recall and reset." "Jump Action Bindings" pushmenu jumpmodbinds
end

begin bindremindersextended
    title "Extended Reminders"
    focus --menu-width

    style --live
    toggle --show-value --status "Show keys bound to inven (the JumpMod menu)." "JumpMod menu" scr_bindreminders_menu
    toggle --show-value --status "Show keys bound to kill." "respawn" scr_bindreminders_respawn
    toggle --show-value --status "Show keys bound to store, including custom Store reminders." "store" scr_bindreminders_store
    toggle --show-value --status "Show keys bound to observer." "observer" scr_bindreminders_observer
end

begin bindreminders1
    title "Bind Reminders 1-4"
    focus --menu-width

    style --live
    static "Commands must match the whole binding."
    static "An empty command hides that row."
    blank
    field --width 32 --length 255 --status "Exact bound command, such as f60, store or +fps 30 120." "command 1" scr_bindreminders_command_1
    field --width 32 --length 127 --status "Action caption; leave empty to show the command." "caption 1" scr_bindreminders_label_1
    blank
    field --width 32 --length 255 --status "Exact bound command, such as f60, store or +fps 30 120." "command 2" scr_bindreminders_command_2
    field --width 32 --length 127 --status "Action caption; leave empty to show the command." "caption 2" scr_bindreminders_label_2
    blank
    field --width 32 --length 255 --status "Exact bound command, such as f60, store or +fps 30 120." "command 3" scr_bindreminders_command_3
    field --width 32 --length 127 --status "Action caption; leave empty to show the command." "caption 3" scr_bindreminders_label_3
    blank
    field --width 32 --length 255 --status "Exact bound command, such as f60, store or +fps 30 120." "command 4" scr_bindreminders_command_4
    field --width 32 --length 127 --status "Action caption; leave empty to show the command." "caption 4" scr_bindreminders_label_4
end

begin bindreminders2
    title "Bind Reminders 5-8"
    focus --menu-width

    style --live
    static "Commands must match the whole binding."
    static "An empty command hides that row."
    blank
    field --width 32 --length 255 --status "Exact bound command, such as f60, store or +fps 30 120." "command 5" scr_bindreminders_command_5
    field --width 32 --length 127 --status "Action caption; leave empty to show the command." "caption 5" scr_bindreminders_label_5
    blank
    field --width 32 --length 255 --status "Exact bound command, such as f60, store or +fps 30 120." "command 6" scr_bindreminders_command_6
    field --width 32 --length 127 --status "Action caption; leave empty to show the command." "caption 6" scr_bindreminders_label_6
    blank
    field --width 32 --length 255 --status "Exact bound command, such as f60, store or +fps 30 120." "command 7" scr_bindreminders_command_7
    field --width 32 --length 127 --status "Action caption; leave empty to show the command." "caption 7" scr_bindreminders_label_7
    blank
    field --width 32 --length 255 --status "Exact bound command, such as f60, store or +fps 30 120." "command 8" scr_bindreminders_command_8
    field --width 32 --length 127 --status "Action caption; leave empty to show the command." "caption 8" scr_bindreminders_label_8
end

begin jumpfpssetup
    title "FPS Controls"
    focus --menu-width

    action --status "Bind keys to instant FPS presets (f20, f31, f60, f120...)." "FPS Preset Bindings" pushmenu jumpfpsbinds
    action --status "Bind keys that lower FPS while held, restore when released." "Hold / Release FPS Bindings" pushmenu jumpholdfps
end

begin jumpfpsbinds
    title "FPS Preset Bindings"
    focus --menu-width

    bind --status "Bind key to set cl_maxfps to 20." "FPS 20" f20
    bind --status "Bind key to set cl_maxfps to 22." "FPS 22" f22
    bind --status "Bind key to set cl_maxfps to 25." "FPS 25" f25
    bind --status "Bind key to set cl_maxfps to 26." "FPS 26" f26
    bind --status "Bind key to set cl_maxfps to 31." "FPS 31" f31
    bind --status "Bind key to set cl_maxfps to 32." "FPS 32" f32
    bind --status "Bind key to set cl_maxfps to 33." "FPS 33" f33
    bind --status "Bind key to set cl_maxfps to 60." "FPS 60" f60
    bind --status "Bind key to set cl_maxfps to 66." "FPS 66" f66
    bind --status "Bind key to set cl_maxfps to 90." "FPS 90" f90
    bind --status "Bind key to set cl_maxfps to 100." "FPS 100" f100
    bind --status "Bind key to set cl_maxfps to 120." "FPS 120" f120
end

begin jumpholdfps
    title "Hold / Release FPS Bindings"
    focus --menu-width
    style --live

    blank
    bindselect2 "1" "+fps_hold 1" fps_hold_1 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_1 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "2" "+fps_hold 2" fps_hold_2 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_2 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "3" "+fps_hold 3" fps_hold_3 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_3 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "4" "+fps_hold 4" fps_hold_4 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_4 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "5" "+fps_hold 5" fps_hold_5 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_5 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "6" "+fps_hold 6" fps_hold_6 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_6 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "7" "+fps_hold 7" fps_hold_7 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_7 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "8" "+fps_hold 8" fps_hold_8 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_8 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "9" "+fps_hold 9" fps_hold_9 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_9 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "10" "+fps_hold 10" fps_hold_10 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_10 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "11" "+fps_hold 11" fps_hold_11 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_11 20 22 25 26 30 31 32 33 60 66 90 100 120
    bindselect2 "12" "+fps_hold 12" fps_hold_12 20 22 25 26 30 31 32 33 60 66 90 100 120 : fps_release_12 20 22 25 26 30 31 32 33 60 66 90 100 120
    blank
    action --status "Open FPS Controls." --align "FPS Controls" pushmenu jumpfpssetup
end

begin jumpmodbinds
    title "Jump Action Bindings"
    focus --menu-width

    static "[Movement / Storage]"
    bind --status "Saves current position and velocity." "store" store
    bind --status "Returns to your stored position." "recall" recall
    bind --status "Resets your current race run." "reset" reset
    bind --status "Fires the grappling hook." "hook" hook
    bind --status "Releases the grappling hook." "unhook" unhook
    blank

    static "[HUD / Information]"
    bind --status "Toggles the replay statistics display." "replay stats" repstats
    bind --status "Toggles jump distance announcement." "show jumps" showjumps
    bind --status "Toggles split times display." "show times" showtimes
    bind --status "Toggles checkpoint arrival sound." "checkpoint sound" cpsound
    bind --status "Shows current frames per second." "show FPS" !fps
    blank

    static "[Social / Team]"
    bind --status "Votes YES in current election." "vote yes" yes
    bind --status "Votes NO in current election." "vote no" no
