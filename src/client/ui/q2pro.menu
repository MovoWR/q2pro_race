begin strafehelper
    title "Strafe Helper"
    focus --menu-width

    style --live
    toggle --show-value --status "Global switch for the strafe helper HUD element." "enabled" sh_draw
    toggle --show-value --status "Show a central mark for neutral mouse position." "center marker" sh_centermarker
    range --show-value --status "Scale factor for the strafe helper bar." "scale" sh_scale 0.5 4.0 0.1
    range --show-value --status "Vertical offset from screen center; negative values move upward." "Y position" sh_y -320 320 5
    range --show-value --status "Height of the strafe helper bar in pixels." "height" sh_height 4 80 1
    range --show-value --status "Transparency of the strafe helper bar." "alpha" sh_alpha 0 1 0.05
    strings --show-value --status "Visual drawing style of the strafe helper." "bar style" sh_bar_style gradient solid outline minimal
    range --show-value --status "Smooth visual movement of strafe helper angles; 0 disables it." "smoothing" sh_smoothing 0 10 0.1
    pairs --show-value --status "Easing curve used by strafe helper smoothing." "   smoothing mode" sh_smoothing_mode linear 1 quadratic 2 cubic 3 sine 4 exponential 5
    range --show-value --status "Width of the center mouse position marker." "center width" sh_center_width 0.1 5 0.1
    range --show-value --status "Width of the optimal acceleration zone." "optimal width" sh_optimal_width 0.1 5 0.1
    toggle --show-value --status "Draw the optimal angle marker as an outline." "optimal outline" sh_optimal_outline
    field --picker --status "Color when mouse is within optimal zone." "accelerating color" sh_color_accelerating
    field --picker --status "Color when moving at perfect angle." "optimal color" sh_color_optimal
    field --picker --status "Color of the center neutral marker." "center marker color" sh_color_centermarker
    blank
    action --status "Choose from a set of pre-defined color schemes." --align "Color Presets" pushmenu shpresets
end

begin shefficiency
    title "Efficiency Display"
    focus --menu-width

    style --live
    toggle --show-value --status "Show the airborne acceleration-efficiency display." "enabled" sh_efficiency
    strings --show-value --status "Show a bar, a percentage readout, both, or neither (tint only)." "style" sh_efficiency_style bar text both none
    strings --show-value --status "Tint strafe helper elements by current efficiency." "helper tint" sh_efficiency_tint off optimal zone both
    range --show-value --status "How strongly the tint overrides the helper colors." "   tint strength" sh_efficiency_tint_strength 0 1 0.05
    range --show-value --status "Width of the efficiency bar in pixels." "width" sh_efficiency_width 8 4000 1
    range --show-value --status "Height of the efficiency bar in pixels." "height" sh_efficiency_height 1 64 1
    range --show-value --status "Horizontal offset from screen center." "X offset" sh_efficiency_x -4000 4000 5
    range --show-value --status "Gap below the helper; negative values place it above." "Y offset" sh_efficiency_y -400 400 1
    toggle --show-value --status "Draw a 1 pixel outline around the bar." "border" sh_efficiency_border
    range --show-value --status "Threshold marker position on the bar; 0 hides it." "marker" sh_efficiency_marker 0 1 0.05
    range --show-value --status "Smooth the displayed value; 0 disables it." "smoothing" sh_efficiency_smoothing 0 10 0.1
    range --show-value --status "Keep the last value on screen this long after data stops." "hold ms" sh_efficiency_hold_ms 0 2000 25
    range --show-value --status "Scale of the percentage text." "text scale" sh_efficiency_text_scale 0.25 8 0.25
    strings --show-value --status "Color by efficiency value, or use one fixed color." "color mode" sh_efficiency_color_mode dynamic static
    field --picker --status "Color near 100% efficiency; also the static color." "good color" sh_efficiency_color_good
    field --picker --status "Color at the gradient midpoint." "mid color" sh_efficiency_color_mid
    field --picker --status "Color near 0% efficiency." "bad color" sh_efficiency_color_bad
    field --picker --status "Background color of the bar track." "background color" sh_efficiency_color_bg
    range --show-value --status "Efficiency value where the mid color sits." "gradient midpoint" sh_efficiency_color_midpoint 0.05 0.95 0.05
end

