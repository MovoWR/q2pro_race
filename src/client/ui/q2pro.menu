    action --status "Magenta, bright white, and black." --align "karen" "sh hud preset karen"
    action --status "Toxic green, yellow, and red explosion." --align "nuclear" "sh hud preset nuclear"
    action --status "Neon yellow, magenta, and cyan." --align "highlighter" "sh hud preset highlighter"
    action --status "Dark black, spooky magenta, and haunting white." --align "cursed" "sh hud preset cursed"
    action --status "Black, white, and gray." --align "zebra" "sh hud preset zebra"
    action --status "Cool icy cyan and white." --align "ice" "sh hud preset ice"
    action --status "Transparent debugging preset." --align "imposs" "sh hud preset imposs"
    action --status "Red, blue, and yellow for a playful feel." --align "clown" "sh hud preset clown"
    action --status "Acidic green and yellow with teal." --align "acid" "sh hud preset acid"
    action --status "Deep cherry red with soft pink accents." --align "cherry" "sh hud preset cherry"
